--categorise customers as 
--18-20: genz,
--21-40:adult,
--41 onward : senior_citizen

select
  CustomerID,
  Age,
  Name,
  case
    when Age >= 18 and Age <= 20 then "Genz"
    when Age >= 21 and Age <= 40 then "Adult"
    else "Senior_citizen"
  end as age_group  
from `e1.customers` as c


